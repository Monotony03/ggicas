generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Country {
  id             String                @id @default(cuid())
  name           String                @unique
  isoCode        String                @unique
  region         String
  gdpCurrentUsd  Float?
  militaryBudget Float?
  alliancesA     Alliance[]            @relation("CountryA")
  alliancesB     Alliance[]            @relation("CountryB")
  conflicts      ConflictInvolvement[]
  sanctionsOut   Sanction[]            @relation("ImposingCountry")
  sanctionsIn    Sanction[]            @relation("TargetCountry")
  tradeSource    TradeRelation[]       @relation("CountryASource")
  tradeDest      TradeRelation[]       @relation("CountryBDest")
  armsExports    ArmsTransfer[]        @relation("ArmsExporter")
  armsImports    ArmsTransfer[]        @relation("ArmsImporter")
  leaders        Leader[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model Leader {
  id         String    @id @default(cuid())
  name       String
  title      String    // e.g., 'President', 'Premier', 'Prime Minister'
  countryId  String
  country    Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime?
  
  @@index([countryId])
}

model Organization {
  id        String     @id @default(cuid())
  name      String     @unique
  type      String // e.g., 'Military', 'Economic', 'Political'
  members   Alliance[] @relation("OrganizationMembers")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Conflict {
  id           String                @id @default(cuid())
  name         String
  type         String // e.g., 'Civil War', 'Invasion', 'Proxy War'
  cause        String?
  startDate    DateTime
  endDate      DateTime?
  participants ConflictInvolvement[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model Alliance {
  id             String        @id @default(cuid())
  countryAId     String
  countryA       Country       @relation("CountryA", fields: [countryAId], references: [id], onDelete: Cascade)
  countryBId     String?
  countryB       Country?      @relation("CountryB", fields: [countryBId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation("OrganizationMembers", fields: [organizationId], references: [id], onDelete: SetNull)
  allianceType   String // e.g., 'Defense Pact', 'Economic Treaty'
  motivation     String?
  startDate      DateTime
  endDate        DateTime?

  @@index([countryAId])
  @@index([countryBId])
  @@index([organizationId])
}

model ConflictInvolvement {
  id         String    @id @default(cuid())
  conflictId String
  conflict   Conflict  @relation(fields: [conflictId], references: [id], onDelete: Cascade)
  countryId  String
  country    Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  role       String // e.g., 'Aggressor', 'Defender', 'Funder'
  startDate  DateTime
  endDate    DateTime?

  @@index([conflictId])
  @@index([countryId])
}

model Sanction {
  id                String    @id @default(cuid())
  imposingCountryId String
  imposingCountry   Country   @relation("ImposingCountry", fields: [imposingCountryId], references: [id], onDelete: Cascade)
  targetCountryId   String
  targetCountry     Country   @relation("TargetCountry", fields: [targetCountryId], references: [id], onDelete: Cascade)
  sanctionType      String // e.g., 'Economic', 'Arms Embargo'
  startDate         DateTime
  endDate           DateTime?

  @@index([imposingCountryId])
  @@index([targetCountryId])
}

model TradeRelation {
  id             String  @id @default(cuid())
  countryAId     String
  countryA       Country @relation("CountryASource", fields: [countryAId], references: [id], onDelete: Cascade)
  countryBId     String
  countryB       Country @relation("CountryBDest", fields: [countryBId], references: [id], onDelete: Cascade)
  year           Int
  tradeVolumeUsd Float?

  @@index([countryAId])
  @@index([countryBId])
}

model ArmsTransfer {
  id             String  @id @default(cuid())
  exporterId     String
  exporter       Country @relation("ArmsExporter", fields: [exporterId], references: [id], onDelete: Cascade)
  importerId     String
  importer       Country @relation("ArmsImporter", fields: [importerId], references: [id], onDelete: Cascade)
  weaponType     String  // e.g., 'Aircraft', 'Missiles', 'Armored Vehicles'
  year           Int
  volumeTIV      Float?  // Trend Indicator Value (SIPRI metric)

  @@index([exporterId])
  @@index([importerId])
}

model AuditLog {
  id          String   @id @default(cuid())
  tableName   String
  recordId    String
  action      String   // e.g., 'UPDATE', 'DELETE'
  oldData     String?  // JSON string
  newData     String?  // JSON string
  timestamp   DateTime @default(now())
}

// ── CAST / ACLED Conflict Forecast ─────────────────────────────────────────
model ConflictForecast {
  id              String   @id @default(cuid())
  countryIso      String   // ISO-3166-1 alpha-2 (e.g. "UA", "SY")
  countryName     String
  forecastMonth   DateTime // First day of the forecast month (UTC midnight)
  bestCase        Int
  expectedCase    Int
  worstCase       Int
  historicalAvg   Float?   // Rolling 12-month average from ACLED
  predictedChange String   // 'increase' | 'decrease' | 'stable'
  violenceType    String   @default("All Event Types")
  region          String?
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([countryIso, forecastMonth, violenceType])
  @@index([forecastMonth])
  @@index([countryIso])
  @@index([region])
}
